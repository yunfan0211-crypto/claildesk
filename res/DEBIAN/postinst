#!/bin/bash

set -e

if [ "$1" = configure ]; then

	INITSYS=$(ls -al /proc/1/exe | awk -F' ' '{print $NF}' | awk -F'/' '{print $NF}')
	ln -f -s /usr/share/claildesk/claildesk /usr/bin/claildesk

	if [ "systemd" == "$INITSYS" ]; then
		# Remove the unit shipped by pre-Claildesk Linux packages. Keeping it
		# enabled would make UI service controls target a different unit name.
		systemctl stop claildesk.service >/dev/null 2>&1 || true
		systemctl disable claildesk.service >/dev/null 2>&1 || true
		rm -f /etc/systemd/system/claildesk.service \
			/usr/lib/systemd/system/claildesk.service \
			/usr/lib/systemd/user/claildesk.service
		mkdir -p /usr/lib/systemd/system/
		cp /usr/share/claildesk/files/systemd/claildesk.service /usr/lib/systemd/system/claildesk.service
		systemctl daemon-reload
		systemctl enable claildesk
		systemctl start claildesk
	fi
fi
