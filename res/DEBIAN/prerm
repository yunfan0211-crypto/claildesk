#!/bin/bash

set -e

case $1 in
	remove|upgrade)
		INITSYS=$(ls -al /proc/1/exe | awk -F' ' '{print $NF}' | awk -F'/' '{print $NF}')

		if [ "systemd" == "${INITSYS}" ]; then
			systemctl stop claildesk || true
			systemctl disable claildesk || true
			# Clean up the old unit as well when removing/upgrading a package that
			# predates the Claildesk service-name migration.
			systemctl stop claildesk || true
			systemctl disable claildesk || true
			rm -f /etc/systemd/system/claildesk.service \
				/usr/lib/systemd/system/claildesk.service \
				/etc/systemd/system/claildesk.service \
				/usr/lib/systemd/system/claildesk.service
			
			# workaround temp dev build between 1.1.9 and 1.2.0
			serverUser=$(ps -ef | grep -E 'claildesk +--server' | grep -v 'sudo ' | awk '{print $1}' | head -1)
			if [ "$serverUser" != "" ] && [ "$serverUser" != "root" ]
			then
				systemctl --machine=${serverUser}@.host --user stop claildesk >/dev/null 2>&1 || true
				systemctl --machine=${serverUser}@.host --user stop claildesk >/dev/null 2>&1 || true
			fi
			rm /usr/lib/systemd/user/claildesk.service >/dev/null 2>&1 || true
			rm /usr/lib/systemd/user/claildesk.service >/dev/null 2>&1 || true
			systemctl daemon-reload
		fi
		rm -f /usr/bin/claildesk
        ;;
esac

exit 0
